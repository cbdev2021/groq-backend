# Configuración del servidor
PORT=10000

# API Key de Groq
# Obtén tu key en: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_aqui

# Modelos en orden de fallback automático (separados por coma, sin espacios)
# Si un modelo llega a su límite gratis (HTTP 429) o falla, se prueba el siguiente
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.6-27b,qwen/qwen3.8-27b,groq/compound-mini,groq/compound

# MongoDB Atlas URI
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/nodeagentgroq?retryWrites=true&w=majority
